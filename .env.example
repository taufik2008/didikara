# ==============================================================================
# LMS PINTAR - Production Environment Configuration Template
# Salin file ini menjadi `.env` di server Anda: `cp .env.example .env`
# ==============================================================================

# Node Environment & Port
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://lms.domainanda.com

# ── Database Configuration (PostgreSQL) ────────────────────────────────────────
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://lms_user:lms_secure_password_123@localhost:5432/lms_db

# ── Security & Authentication ─────────────────────────────────────────────────
# Generate secret key dengan: openssl rand -base64 32
JWT_SECRET=rahasia_jwt_sangat_panjang_dan_aman_produksi_lms_2026_sdilms_key

# ── Payment Gateway (Midtrans / Xendit / Manual Invoice) ───────────────────────
# Kosongkan jika menggunakan sistem invoice / transfer manual internal
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── Email Service / SMTP Notification (Nodemailer) ────────────────────────────
# Digunakan untuk notifikasi pendaftaran, reset password, & invoice
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifikasi@domainanda.com
SMTP_PASS=app_password_email_anda
SMTP_FROM="LMS Pintar <notifikasi@domainanda.com>"

# ── Cloud Storage (Opsional: AWS S3 / Cloudflare R2 / Google Drive) ────────────
# Kosongkan jika menggunakan penyimpanan lokal server atau embed cloud
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
